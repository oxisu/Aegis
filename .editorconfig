# EditorConfig —— 跨编辑器统一基础格式
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Rust 源码
[*.rs]
indent_size = 4
max_line_length = 100

# 配置 / 数据序列化：缩进 2
[*.{yml,yaml,json,toml}]
indent_size = 2

# Markdown：行尾双空格是换行语义，禁止裁剪
[*.md]
trim_trailing_whitespace = false

# Windows 脚本必须 CRLF
[*.{ps1,bat,cmd}]
end_of_line = crlf

# Makefile 类必须 Tab
[Makefile]
indent_style = tab
